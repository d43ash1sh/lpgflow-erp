# LPGFlow ERP - Environment Variables Template
# Copy this file to .env.local to customize for production deployments

# Public WhatsApp Number for Click-to-Chat CTA (Format: Country Code + Digits without '+' or spaces, e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://lpgflow-erp.vercel.app

# Plant Contact Channels
NEXT_PUBLIC_CONTACT_EMAIL=operations@lpgflow.internal
NEXT_PUBLIC_CONTACT_PHONE=+91 98765 43210

# Phase 1 Future Backend Placeholders (DO NOT SET IN PHASE 0)
# DATABASE_URL=postgresql://user:password@host:5432/lpg_erp
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# RAZORPAY_KEY_ID=
# MSG91_AUTH_KEY=
